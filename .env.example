# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token

# OpenAI-compatible chat completions API
AI_BASE_URL=https://ai.nube.sh/api/v1
AI_API_KEY=sk-replace-me
AI_MODEL=kimi-k2.5

# Optional tuning
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.4
INTENT_CONFIDENCE_THRESHOLD=0.28
KNOWLEDGE_SNIPPET_CHARS=12000
LOG_LEVEL=INFO

# Nightly free-config job (optional; needs 3X-UI panel API)
NIGHTLY_ENABLED=false
NIGHTLY_IRAN_TIME=21:00
NIGHTLY_SUPPORT_CHAT_ID=@YourSupportAccount
PANEL_BASE_URL=https://your-panel-domain/panel
PANEL_API_TOKEN=replace-with-3xui-panel-api-token
PANEL_INBOUND_ID=1
PANEL_REQUIRED_PORT=443

# Conversation analysis drafts (optional)
CONVO_ANALYSIS_ENABLED=false
CONVO_ANALYSIS_TIMES=12:30
CONVO_ANALYSIS_CHAT_ID=YOUR_TELEGRAM_USER_ID
CONVO_ANALYSIS_TEST_MODE=true
CONVO_MIN_OCCURRENCES=3
CONVO_MIN_USERS=1
CONVO_PRIORITY_THRESHOLD=55

# Admin Telegram user IDs (comma-separated) — required for settings menus
BOT_ADMIN_IDS=YOUR_TELEGRAM_USER_ID
AI_BUDGET_USD=50
AI_USD_PER_MILLION_TOKENS=2.0

# Safe-change confirm destination (usually same as admin)
SAFETY_CONFIRM_CHAT_ID=YOUR_TELEGRAM_USER_ID

# Social / news posts (optional)
SOCIAL_NEWS_ENABLED=true
SOCIAL_NEWS_CHAT_ID=@YourChannelOrAccount
SOCIAL_NEWS_TIMES=10:00,17:00
