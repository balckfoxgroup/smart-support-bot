[Unit]
Description=Smart Support Bot (Telegram AI support — long polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/smart-support-bot
EnvironmentFile=/opt/smart-support-bot/.env
ExecStart=/opt/smart-support-bot/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/smart-support-bot/data /opt/smart-support-bot-safety

[Install]
WantedBy=multi-user.target
